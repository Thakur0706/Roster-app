generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS_MANAGER
  POD_LEAD
}

enum OperatingRule {
  ALL_365
  DAILY_EXCEPT_PUBLIC_HOLIDAYS
  NO_SUNDAYS_AND_HOLIDAYS
}

enum LeaveType {
  PLANNED_LEAVE
  COMP_OFF
  SICK_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RosterStatus {
  DRAFT
  PUBLISHED
}

enum EntryStatus {
  WORKING
  WEEKLY_OFF
  PUBLIC_HOLIDAY
  LEAVE
  COMP_OFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPS_MANAGER)
  createdAt    DateTime @default(now())
}

model Pod {
  id        String     @id @default(cuid())
  name      String     @unique
  leadId    String?    @unique
  lead      Employee?  @relation("PodLead", fields: [leadId], references: [id], onDelete: SetNull)
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  podId        String?
  pod          Pod?     @relation(fields: [podId], references: [id], onDelete: SetNull)
  weeklyOffDay Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  ledPod        Pod?          @relation("PodLead")
  assignments   Assignment[]
  leaves        Leave[]
  rosterEntries RosterEntry[]
}

model Brand {
  id             String          @id @default(cuid())
  name           String          @unique
  operatingRule  OperatingRule   @default(DAILY_EXCEPT_PUBLIC_HOLIDAYS)
  brandProcesses BrandProcess[]
  createdAt      DateTime        @default(now())
}

model Process {
  id             String         @id @default(cuid())
  name           String         @unique
  brandProcesses BrandProcess[]
  createdAt      DateTime       @default(now())
}

model BrandProcess {
  id            String         @id @default(cuid())
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  processId     String
  process       Process        @relation(fields: [processId], references: [id], onDelete: Cascade)
  operatingRule OperatingRule?
  minCoverage   Int            @default(1)
  assignments   Assignment[]
  rosterEntries RosterEntry[]
  createdAt     DateTime       @default(now())

  @@unique([brandId, processId])
}

model Assignment {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  brandProcessId String
  brandProcess   BrandProcess @relation(fields: [brandProcessId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([employeeId, brandProcessId])
}

model Leave {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  type       LeaveType   @default(PLANNED_LEAVE)
  status     LeaveStatus @default(PENDING)
  reason     String?
  createdAt  DateTime    @default(now())
}

model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date @unique
  name      String
  createdAt DateTime @default(now())
}

model Roster {
  id        String       @id @default(cuid())
  month     Int
  year      Int
  status    RosterStatus @default(DRAFT)
  entries   RosterEntry[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([month, year])
}

model RosterEntry {
  id             String        @id @default(cuid())
  rosterId       String
  roster         Roster        @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  brandProcessId String?
  brandProcess   BrandProcess? @relation(fields: [brandProcessId], references: [id], onDelete: SetNull)
  status         EntryStatus   @default(WEEKLY_OFF)
  createdAt      DateTime      @default(now())

  @@unique([rosterId, date, employeeId])
  @@index([rosterId, date])
}
